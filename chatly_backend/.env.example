DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatly?schema=public"
REDIS_URL= # optional; Render Key Value connection string (rediss://...). Takes priority over REDIS_HOST/REDIS_PORT.
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
RESEND_API_KEY=
RESEND_FROM="Chatly <no-reply@example.com>"