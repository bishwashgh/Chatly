{
  "expo": {
    "name": "Chatly",
    "slug": "chatly",
    "scheme": "chatly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5F7",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.chatly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Chatly uses the camera for video calls and sending photos.",
        "NSMicrophoneUsageDescription": "Chatly uses the microphone for voice notes and audio calls.",
        "NSPhotoLibraryUsageDescription": "Chatly accesses your photo library so you can send photos and videos.",
        "NSPhotoLibraryAddUsageDescription": "Chatly saves photos downloaded from conversations to your photo library."
      }
    },
    "android": {
      "package": "com.chatly.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F5F5F7"
      }
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F7"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_GOOGLE_CLIENT_ID"
        }
      ],
      "./plugins/withLiveKitPermissions",
      "expo-camera",
      "expo-document-picker",
      "expo-media-library",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "540f4c32-e7c2-4cc5-906f-4ff065c83cf8"
      }
    }
  }
}
