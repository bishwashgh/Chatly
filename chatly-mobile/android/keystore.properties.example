# Release signing credentials for local Gradle builds.
#
# Copy this file to `keystore.properties` (same directory — android/) and fill in
# real values. `keystore.properties` is git-ignored: NEVER commit it, and never
# commit the .keystore/.jks file itself.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# ---------------------------------------------------------------------------
# 1. Generate the keystore (once). Requires `keytool` (ships with any JDK).
#
#      cd chatly-mobile/android/app
#      keytool -genkeypair -v \
#        -storetype PKCS12 \
#        -keystore chatly-release.keystore \
#        -alias chatly \
#        -keyalg RSA \
#        -keysize 2048 \
#        -validity 10000
#
#    It will ask for a password and for your name/org details. The password you
#    type is the `storePassword` AND `keyPassword` below.
#
#    IMPORTANT: back this file up somewhere safe and offline. With Play App
#    Signing you can recover from a lost upload key; without it, losing the
#    keystore means you can never publish an update to the same app listing.
#
# 2. Fill in the four values below.
#
# 3. Build:
#      cd chatly-mobile/android
#      ./gradlew assembleRelease     # APK -> app/build/outputs/apk/release/
#      ./gradlew bundleRelease       # AAB -> app/build/outputs/bundle/release/
#
# ---------------------------------------------------------------------------
# Path to the keystore. An absolute path always works. A relative path is
# resolved from `android/app/` (the Gradle app module directory), so
# `chatly-release.keystore` means `android/app/chatly-release.keystore`.
#
# Alternatively leave this file absent and export the equivalent environment
# variables (useful on CI):
#   CHATLY_UPLOAD_STORE_FILE, CHATLY_UPLOAD_STORE_PASSWORD,
#   CHATLY_UPLOAD_KEY_ALIAS, CHATLY_UPLOAD_KEY_PASSWORD

storeFile=chatly-release.keystore
storePassword=CHANGE_ME
keyAlias=chatly
keyPassword=CHANGE_ME
