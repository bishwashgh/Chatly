# On a physical phone, localhost points at the phone itself — use your computer's LAN IP.
# Find it with: hostname -I  (Linux) / ipconfig getifaddr en0 (macOS) / ipconfig (Windows)
EXPO_PUBLIC_API_HTTP_URL=http://192.168.1.7:4000/graphql
EXPO_PUBLIC_API_WS_URL=ws://192.168.1.7:4000/graphql
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud