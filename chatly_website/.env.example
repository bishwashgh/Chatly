# Chatly web client configuration.
# Copy this file to `.env` and set the URLs for your deployed backend.

# GraphQL HTTP endpoint (use https:// in production).
VITE_API_HTTP_URL=https://chatly-backend-6qxq.onrender.com/graphql

# GraphQL WebSocket endpoint used for subscriptions (must be wss:// in production).
VITE_API_WS_URL=wss://chatly-backend-6qxq.onrender.com/graphql

# LiveKit WebSocket URL, used for audio/video calls.
VITE_LIVEKIT_URL=wss://chatly-q41rks5z.livekit.cloud
